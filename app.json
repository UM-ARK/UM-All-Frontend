{
  "expo": {
    "name": "ARK ALL",
    "slug": "arkall",
    "scheme": "one.umall",
    "version": "26.8.0",
    "icon": "./src/static/img/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "icon": "./src/static/img/logo.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "one.umall",
      "buildNumber": "26.8.0",
      "associatedDomains": [
        "applinks:umall.one",
        "webcredentials:umall.one"
      ],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "LSApplicationCategoryType": "public.app-category.utilities",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "googleServicesFile": "./google-services.json",
      "package": "one.umall",
      "versionCode": 78,
      "adaptiveIcon": {
        "foregroundImage": "./src/static/img/ic_launcher_foreground.png",
        "backgroundColor": "#E6AB52"
      },
      "icon": "./src/static/img/logo.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "umall.one",
              "pathPrefix": "/auth/discourse"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withAndroidSigning",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      [
        "expo-media-library",
        {
          "photosPermission": "允許 ARK ALL 訪問您的照片以保存圖片。",
          "savePhotosPermission": "允許 ARK ALL 保存照片到相冊。",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許 ARK ALL 訪問您的照片以選擇圖片。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/static/img/logo_round.png",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-system-ui",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "react-native-quick-crypto",
      "expo-quick-actions",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "cf0bd876-f7b8-4a6d-b40c-a1708d2d636c"
      }
    },
    "owner": "arkall"
  }
}
