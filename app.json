{
  "expo": {
    "name": "ARK ALL",
    "displayName": "ARK ALL",
    "slug": "arkall",
    "version": "26.1.1",
    "icon": "./src/static/img/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "icon": "./src/static/img/logo.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "one.umall",
      "buildNumber": "26.1.1",
      "deploymentTarget": "15.1"
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "googleServicesFile": "./google-services.json",
      "package": "one.umall",
      "versionCode": 74,
      "adaptiveIcon": {
        "foregroundImage": "./src/static/img/logo.png",
        "backgroundColor": "#E6AB52"
      },
      "icon": "./src/static/img/logo.png",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-firebase/app",
      [
        "expo-media-library",
        {
          "photosPermission": "允許 ARK ALL 訪問您的照片以保存圖片。",
          "savePhotosPermission": "允許 ARK ALL 保存照片到相冊。",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許 ARK ALL 訪問您的照片以選擇圖片。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./src/static/img/transparent.png",
            "dark": {
              "image": "./src/static/img/transparent.png",
              "backgroundColor": "#000000"
            }
          }
        }
      ],
      "expo-system-ui"
    ]
  }
}